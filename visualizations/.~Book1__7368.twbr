      </column>
      <column caption='Global Incident Rate' datatype='real' name='[Calculation_426153172354965506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [safety_incident_flag] = TRUE THEN 1 ELSE 0 END) &#10;/ &#10;COUNT([audit_id])' />
      </column>
      <column caption='Incident Rate Alert' datatype='boolean' name='[Calculation_426153172355264515]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_426153172354965506] &gt; 0.025' />
      </column>
      <column caption='On-Time Performance' datatype='real' name='[Calculation_426153172356546564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_on_time] = TRUE THEN 1 ELSE 0 END) / COUNT([audit_id])' />
      </column>
      <column caption='Late Performance' datatype='real' name='[Calculation_426153172357607430]' role='measure' type='quantitative'>

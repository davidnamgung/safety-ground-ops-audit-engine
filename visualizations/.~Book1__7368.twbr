  <worksheets>
    <worksheet name='Geospatial Risk Map'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>This map visualizes safety compliance across our global ground handling network. By plotting the aggregate incident rate against total flight volume, it identifies geographical risk zones. This intelligence enables the central operations team to move away from random inspections and intelligently deploy safety auditors to high-risk hubs.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ground_ops_clean_sql' name='federated.15j3zxi0yfz8jv14vfa3t0760vln' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.15j3zxi0yfz8jv14vfa3t0760vln'>
            <column caption='Global Incident Rate' datatype='real' name='[Calculation_426153172354965506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [safety_incident_flag] = TRUE THEN 1 ELSE 0 END) &#10;/ &#10;COUNT([audit_id])' />
            </column>
            <column-instance column='[station_code]' derivation='Attribute' name='[attr:station_code:nk]' pivot='key' type='nominal' />
            <column caption='Audit Id' datatype='integer' name='[audit_id]' role='dimension' type='ordinal' />
            <column-instance column='[audit_id]' derivation='Count' name='[cnt:audit_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_426153172354965506]' derivation='User' name='[cum:usr:Calculation_426153172354965506:qk]' pivot='key' type='quantitative'>
              <table-calc aggregation='Sum' ordering-type='Rows' type='CumTotal' />
            </column-instance>
            <column-instance column='[station_code]' derivation='None' name='[none:station_code:nk]' pivot='key' type='nominal' />
            <column caption='Safety Incident Flag' datatype='boolean' name='[safety_incident_flag]' role='dimension' type='nominal' />
            <column caption='Station Code' datatype='string' name='[station_code]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_426153172354965506]' derivation='User' name='[usr:Calculation_426153172354965506:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.15j3zxi0yfz8jv14vfa3t0760vln].[none:station_code:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;SIN&quot;</bucket>

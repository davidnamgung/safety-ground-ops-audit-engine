    <worksheet name='Speed-Safety Paradox'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>This dual-axis analysis contrasts turnaround volume against safety incident frequency. The data reveals a critical operational insight: a distinct &quot;Risk Spike&quot; occurs on the left side of the distribution. It proves that when ground crews are rushed and forced into a negative variance state to beat their targets, the probability of severe safety protocol breaches increases significantly.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ground_ops_clean_sql' name='federated.15j3zxi0yfz8jv14vfa3t0760vln' />
          </datasources>
          <datasource-dependencies datasource='federated.15j3zxi0yfz8jv14vfa3t0760vln'>
            <column caption='Global Incident Rate' datatype='real' name='[Calculation_426153172354965506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [safety_incident_flag] = TRUE THEN 1 ELSE 0 END) &#10;/ &#10;COUNT([audit_id])' />
            </column>
            <column aggregation='None' caption='Variance Bins' datatype='integer' name='[Turnaround Variance Mins (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='1' formula='[turnaround_variance_mins]' peg='0' size='10' />
            </column>
            <column caption='Audit Id' datatype='integer' name='[audit_id]' role='dimension' type='ordinal' />
            <column-instance column='[audit_id]' derivation='Count' name='[cnt:audit_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Turnaround Variance Mins (bin)]' derivation='None' name='[none:Turnaround Variance Mins (bin):ok]' pivot='key' type='ordinal' />
            <column caption='Safety Incident Flag' datatype='boolean' name='[safety_incident_flag]' role='dimension' type='nominal' />
            <column caption='Turnaround Variance Mins' datatype='integer' name='[turnaround_variance_mins]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_426153172354965506]' derivation='User' name='[usr:Calculation_426153172354965506:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.15j3zxi0yfz8jv14vfa3t0760vln].[usr:Calculation_426153172354965506:qk]' field-type='quantitative' fold='true' scope='rows' type='space' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#00000000' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='color' value='#ffffff' />
            <format attr='font-family' value='Tableau Light' />
            <format attr='font-weight' value='bold' />
          </style-rule>
